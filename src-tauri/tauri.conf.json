{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Largy Launcher",
  "version": "1.0.1",
  "identifier": "com.largylauncher.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Largy Launcher",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/instances/*/screenshots/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZEMkNDMzQzOERDMDgzNkIKUldScmc4Q05ROE1zL1djQWdzQzJtZlJrVXN2UFhhREl0TDMzM2NuWDNua0dDdTBWMU9oYTdEWkEK",
      "endpoints": [
        "https://github.com/Largy-dev/Largy-Launcher/releases/latest/download/latest.json"
      ]
    }
  }
}
